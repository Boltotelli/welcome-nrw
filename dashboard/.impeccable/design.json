      "css": ".ds-mission{display:flex;align-items:flex-start;gap:12px;padding:12px 0;color:var(--ink,#f8f5e9);font:14px/1.65 'NRW Interface',system-ui,sans-serif;cursor:pointer}.ds-mission input{appearance:auto;accent-color:var(--gold,#e0bd71);width:20px;height:20px;flex:0 0 20px;margin:2px 0}.ds-mission input:checked+span{text-decoration:line-through;color:var(--muted,#b9b7aa)}.ds-mission input:focus-visible{outline:3px solid var(--gold,#e0bd71);outline-offset:4px}"
