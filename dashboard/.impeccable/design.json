      "html": "<nav class=\"ds-nav\" aria-label=\"Player Dashboard\"><a href=\"#dailyPlan\">Daily plan</a><a href=\"#eventGuides\">Event guides</a></nav>",
      "css": ".ds-nav{display:flex;gap:28px;flex-wrap:wrap;padding:18px 0;border-bottom:1px solid var(--line,#3b3a32);font:650 14px 'NRW Interface',system-ui,sans-serif}.ds-nav a{color:var(--ink,#f8f5e9);padding:8px 0;text-decoration:none}.ds-nav a:hover{text-decoration:underline;text-underline-offset:.22em}.ds-nav a:focus-visible{outline:3px solid var(--gold,#e0bd71);outline-offset:4px}"
