      "html": "<details class=\"ds-event\"><summary>Bear Hunt</summary><p>Follow the current NRW instructions.</p></details>",
      "css": ".ds-event{background:var(--surface,#1c1c19);color:var(--ink,#f8f5e9);border:0;border-radius:12px;overflow:hidden;font-family:'NRW Interface',system-ui,sans-serif}.ds-event summary{padding:17px 18px;font-size:17px;cursor:pointer}.ds-event summary:hover{background:var(--surface2,#282822)}.ds-event summary:focus-visible{outline:3px solid var(--gold,#e0bd71);outline-offset:-4px}.ds-event[open] summary{border-bottom:1px solid var(--line,#3b3a32)}.ds-event p{padding:0 20px 22px;font-size:14px;line-height:1.65}"
