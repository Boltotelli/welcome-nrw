{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/dashboard/",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/leitung",
      "destination": "/leitung/index.html"
    },
    {
      "source": "/leitung/",
      "destination": "/leitung/index.html"
    },
    {
      "source": "/bear",
      "destination": "/bear/preview-v3.html"
    },
    {
      "source": "/bear/",
      "destination": "/bear/preview-v3.html"
    },
    {
      "source": "/bear/examples/:file",
      "destination": "https://boltotelli.github.io/welcome-nrw/examples/:file"
    },
    {
      "source": "/bear/assets/:file",
      "destination": "https://boltotelli.github.io/welcome-nrw/assets/:file"
    }
  ]
}
